{
  "name": "matter-layer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "matter-layer": "src/server.ts"
  },
  "exports": {
    "./rules": "./src/api/rules.ts",
    "./devices": "./src/api/devices.ts",
    "./presets": "./src/devices/index.ts"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:live": "scripts/dev-live.sh",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite --host 0.0.0.0",
    "web:build": "vite build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "lucide-react": "^1.16.0",
    "vite": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.0"
  },
  "license": "Apache-2.0"
}
